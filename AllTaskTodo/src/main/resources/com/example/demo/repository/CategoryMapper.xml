<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.repository.CategoryMapper">

    <select id="findAll" resultType="com.example.demo.entity.Category"> SELECT id, name FROM
        categories </select>

    <insert id="addCategory" useGeneratedKeys="true" keyProperty="id"> insert INTO categories(name)
        VALUES(#{name}) </insert>

    <update id="updateCategory" parameterType="com.example.demo.entity.Category"> UPDATE categories
        SET name = #{name} WHERE id = #{id} </update>

    <select id="findById" parameterType="int" resultType="com.example.demo.entity.Category"> SELECT
        id, name FROM categories WHERE id = #{id} </select>

</mapper>